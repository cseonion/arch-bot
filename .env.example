DISCORD_TOKEN=replace-with-your-discord-bot-token
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: commands appear immediately in this server while developing.
DISCORD_GUILD_ID=

# Channel IDs for autonomous agent conversations.
DISCORD_TASK1_CHANNEL_ID=
DISCORD_TASK2_CHANNEL_ID=

# Balanced default; change without editing code.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4000

# Optional: override the agent profile directory.
ARCH_BOT_AGENT_CONFIG_DIR=config/agents
